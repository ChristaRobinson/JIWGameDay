<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Label text="Score: 0" name="ScoreLabel" style="top: 20px; align-self: center; font-size: 20px; color: rgb(250, 250, 210); -unity-font-style: bold; left: auto;"/>
    <ui:Button text="Restart" name="RestartButton" display-tooltip-when-elided="false" style="position: absolute; top: 50%; align-self: center; font-size: 20px; -unity-font-style: bold; color: rgb(186, 85, 211);"/>
    <ui:Label text="High Score: 0" name="HighScoreLabel" style="top: 12px; right: 0; left: 30px; -unity-font-style: bold; color: rgb(250, 250, 210); font-size: 15px;"/>
    <ui:Label text="TOP 3 SCORES&#10;1. 0&#10;2. 0&#10;3. 0" name="TopScoresLabel" style="-unity-font-style: bold; color: rgb(250, 250, 210); left: 30px; font-size: 10px;"/>
</ui:UXML>
